#===============================================================================
# yukkuremotion-playground .gitignore
# Remotion + AquesTalk 音声合成プロジェクト
#===============================================================================

# 環境設定
.env
.env.*
*.local
service-account.json
credentials.json

# AquesTalk キー（重要！）
aquest-keys.ts

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*

# TypeScript ビルド出力
dist/
build/

# Remotion 出力動画（重要！）
out/

# 音声ファイル（生成物）
/public/audio/yukkuri/
/vendor/

# OS / エディタ
.DS_Store
Thumbs.db
.vscode/
.cursor/
.idea/
*.swp
*~

# ログ
*.log
